# FlockHopper Environment Configuration
# Copy this file to .env and update values as needed

# FlockHopper API URL
# Default: https://api.dontgetflocked.com
VITE_API_URL=https://api.dontgetflocked.com

# --- Basemap tiles ---------------------------------------------------------
# Preferred: self-hosted PMTiles vector basemap (e.g. a Canada extract on
# Cloudflare R2). When set, the map reads tiles directly from this archive via
# HTTP range requests — no tile server needed. Leave blank to use VITE_TILES_URL.
# VITE_PMTILES_URL=https://tiles.your-domain.ca/canada.pmtiles

# Legacy z/x/y tile server base (only used when VITE_PMTILES_URL is blank).
VITE_TILES_URL=https://tiles.dontgetflocked.com

# Protomaps fonts (glyphs) + sprites base URL.
# Default is Protomaps' public assets host; override to self-host on R2.
# VITE_BASEMAP_ASSETS_URL=https://protomaps.github.io/basemaps-assets

# Data API URL (Cloudflare Worker serving GeoJSON)
# Default: https://data.dontgetflocked.com
# For local dev with wrangler: http://localhost:8787
VITE_DATA_API_URL=https://data.dontgetflocked.com

# Performance logging (development only)
VITE_PERF_LOGGING=false

VITE_GEOCODE_API_URL=https://api.deflock.org/geocode/multi
