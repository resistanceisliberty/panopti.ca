# =============================================================================
# SECURITY HEADERS (Applied to all routes)
# =============================================================================
/*
  # Content Security Policy. Strict on the XSS/clickjacking-critical directives
  # (script-src 'self', object-src none, base-uri self, frame-ancestors none).
  # Deliberately permissive (https:) on connect-src/img-src because the map talks
  # to several env-dependent hosts (tiles, routing/data API, geocoders, OSM/
  # Wikimedia imagery) — listing them exactly risks blanking the map. WebGL needs
  # worker-src blob: (MapLibre workers) and inline styles for map controls.
  # static.cloudflareinsights.com is Cloudflare Web Analytics, auto-injected by Pages.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests

  # Clickjacking (the map app is not meant to be embedded). frame-ancestors covers
  # modern browsers; X-Frame-Options covers older ones.
  X-Frame-Options: DENY

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser features
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()

# =============================================================================
# RESOURCE-SPECIFIC HEADERS
# =============================================================================

# JSON data files
/*.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# Canada ALPR dataset — refreshed nightly by CI. Allow short browser caching but
# revalidate so users pick up the new data within an hour of each deploy.
# (Content-Type + CORS are inherited from the /*.json rule above; don't repeat
# them here or Cloudflare emits a duplicated, spec-invalid header value.)
/cameras-ca.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
